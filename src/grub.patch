+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Included by gui_list.c. Software-rendered carousel, bounded bitmap cache.
+ * No floating point, filesystem writes, menu model changes or boot commands.
+ */
+static void
+carousel_clear (list_impl_t self)
+{
+  int i, j;
+  for (i = 0; i < 7; i++)
+    {
+      for (j = 0; j < 17; j++)
+        {
+          grub_video_bitmap_destroy (self->carousel_cache[i].sizes[j]);
+          self->carousel_cache[i].sizes[j] = 0;
+        }
+      self->carousel_cache[i].entry = 0;
+    }
+}
+
+static struct grub_video_bitmap *
+carousel_icon (list_impl_t self, int index, int level, int maximum)
+{
+  int slot = index % 7, j;
+  grub_menu_entry_t entry = grub_menu_get_entry (self->view->menu, index);
+  struct grub_video_bitmap *source;
+  int size = maximum * (16 + level) / 32;
+
+  if (self->carousel_cache[slot].entry != entry
+      || self->carousel_cache[slot].maximum != maximum)
+    {
+      for (j = 0; j < 17; j++)
+        {
+          grub_video_bitmap_destroy (self->carousel_cache[slot].sizes[j]);
+          self->carousel_cache[slot].sizes[j] = 0;
+        }
+      self->carousel_cache[slot].entry = entry;
+      self->carousel_cache[slot].maximum = maximum;
+    }
+  if (!self->carousel_cache[slot].sizes[level])
+    {
+      source = get_item_icon (self, index);
+      if (!source)
+        {
+          struct grub_menu_entry_class generic = { .name = entry && entry->submenu ? "recovery" : "os", .next = 0 };
+          struct grub_menu_entry fallback = { .classes = &generic };
+          source = grub_gfxmenu_icon_manager_get_icon (self->icon_manager, &fallback);
+        }
+      if (source)
+        grub_video_bitmap_create_scaled (&self->carousel_cache[slot].sizes[level],
+                                         size, size, source,
+                                         GRUB_VIDEO_BITMAP_SCALE_METHOD_BEST);
+      /* Missing art never prevents booting or painting the title. */
+      grub_errno = GRUB_ERR_NONE;
+    }
+  return self->carousel_cache[slot].sizes[level];
+}
+
+static void
+carousel_paint (list_impl_t self)
+{
+  grub_gfxmenu_view_t view = self->view;
+  int position = view->carousel_animating ? view->carousel_position : view->selected * 1024;
+  int focus = position / 1024;
+  int w = self->bounds.width, h = self->bounds.height;
+  int scale = grub_min (view->screen.height * 1024 / 1080,
+                        view->screen.width * 1024 / 1280);
+  int maximum = grub_min (320 * scale / 1024,
+                          grub_min (w * 25 / 100, h * 61 / 100));
+  int spacing = grub_min (w * 30 / 100, h * 82 / 100);
+  int i;
+  grub_video_rect_t saved;
+
+  grub_gui_set_viewport (&self->bounds, &saved);
+  for (i = grub_max (0, focus - 2); i <= grub_min (view->menu->size - 1, focus + 3); i++)
+    {
+      int delta = i * 1024 - position;
+      int distance = grub_abs (delta);
+      int level = 16 - grub_min (16, distance * 16 / 1024);
+      int size = maximum * (16 + level) / 32;
+      int x = w / 2 + delta * spacing / 1024;
+      int y = h * 42 / 100;
+      struct grub_video_bitmap *icon;
+      grub_menu_entry_t entry;
+      grub_font_t f;
+      int tw;
+      char *title;
+      if (distance > 1536 || x - size / 2 < 0 || x + size / 2 > w)
+        continue;
+      icon = carousel_icon (self, i, level, maximum);
+      if (icon)
+        grub_video_blit_bitmap (icon, GRUB_VIDEO_BLIT_BLEND,
+                                x - size / 2, y - size / 2, 0, 0, size, size);
+      entry = grub_menu_get_entry (view->menu, i);
+      if (!entry)
+        continue;
+      {
+        char name[48];
+        grub_snprintf (name, sizeof (name), "Caelestia Regular %d",
+                       grub_gfxmenu_font_size (view, i == view->selected ? 24 : 20));
+        f = grub_font_get (name);
+      }
+      /* Never pass signed coordinates to GRUB's unsigned viewport API.
+         Only complete columns are painted; no offscreen text can leak. */
+      {
+        int width = spacing * 90 / 100;
+        int left = x - width / 2;
+        int top = y + size / 2 + grub_max (10, h * 2 / 100);
+        int height = grub_font_get_ascent (f) + grub_font_get_descent (f) + 4;
+        grub_video_rect_t clip, title_saved;
+        if (left < 0 || left + width > w || top < 0 || top + height > h)
+          continue;
+        title = grub_strdup (entry->title);
+        if (!title)
+          { grub_errno = GRUB_ERR_NONE; continue; }
+        tw = grub_font_get_string_width (f, title);
+        if (tw > width)
+          {
+            /* Truncate at UTF-8 boundaries, leaving room for an ellipsis.
+               The actual menu title and boot commands remain untouched. */
+            grub_size_t end = grub_strlen (title);
+            int dots = grub_font_get_string_width (f, "...");
+            while (end && grub_font_get_string_width (f, title) > width - dots)
+              {
+                do { end--; } while (end && (title[end] & 0xc0) == 0x80);
+                title[end] = 0;
+              }
+            grub_free (title);
+            title = grub_xasprintf ("%.*s...", (int) end, entry->title);
+            if (!title)
+              { grub_errno = GRUB_ERR_NONE; continue; }
+            tw = grub_font_get_string_width (f, title);
+          }
+        clip.x = left; clip.y = top; clip.width = width; clip.height = height;
+        grub_gui_set_viewport (&clip, &title_saved);
+        grub_font_draw_string (title, f,
+                               grub_video_map_rgba_color ((i == view->selected)
+                                 ? self->selected_item_color : self->item_color),
+                               grub_max (0, (width - tw) / 2),
+                               grub_font_get_ascent (f));
+        grub_gui_restore_viewport (&title_saved);
+        grub_free (title);
+      }
+    }
+  /* Discrete position marks are useful for menus longer than three entries. */
+  {
+    int unit = grub_max (2, 4 * scale / 1024);
+    int step = grub_max (10, 18 * scale / 1024);
+    int count = grub_min (9, view->menu->size);
+    int first = grub_max (0, grub_min (view->selected - 4, view->menu->size - count));
+    for (i = 0; i < count; i++)
+      grub_video_fill_rect (grub_video_map_rgba_color ((first + i == view->selected)
+                            ? self->selected_item_color : self->item_color),
+                            w / 2 - count * step / 2 + i * step, h - unit * 2,
+                            first + i == view->selected ? unit * 3 : unit, unit);
+  }
+  grub_gui_restore_viewport (&saved);
+}
