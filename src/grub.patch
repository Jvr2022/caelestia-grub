+int
+grub_gfxmenu_font_size (grub_gfxmenu_view_t view, int base)
+{
+  const int sizes[] = { 12, 14, 16, 20, 24, 32, 40, 48, 64, 80, 96, 128 };
+  int target = base * grub_min (view->screen.height * 1024 / 1080,
+                                view->screen.width * 1024 / 1280) / 1024;
+  unsigned i;
+  int result = sizes[0];
+  for (i = 0; i < ARRAY_SIZE (sizes); i++)
+    if (sizes[i] <= target) result = sizes[i];
+  return result;
+}
+
+static void
+caelestia_layout (grub_gui_component_t component, void *data)
+{
+  grub_gfxmenu_view_t view = data;
+  const char *id = component->ops->get_id (component);
+  char font[48];
+  if (!id) return;
+  if (!grub_strcmp (id, "caelestia-heading"))
+    {
+      grub_snprintf (font, sizeof (font), "Caelestia Regular %d",
+                     grub_gfxmenu_font_size (view, 32));
+      component->ops->set_property (component, "font", font);
+    }
+  else if (!grub_strcmp (id, "__timeout__"))
+    {
+      grub_snprintf (font, sizeof (font), "Caelestia Regular %d",
+                     grub_gfxmenu_font_size (view, 16));
+      component->ops->set_property (component, "font", font);
+    }
+  else if (!grub_strcmp (id, "caelestia-controls"))
+    {
+      grub_video_rect_t bounds;
+      int width = grub_min (view->screen.width * 90 / 100,
+                            640 * grub_max (810, view->screen.height) / 1080);
+      component->ops->get_bounds (component, &bounds);
+      bounds.width = grub_max (160, width);
+      bounds.height = bounds.width / 16;
+      bounds.x = (view->screen.width - bounds.width) / 2;
+      component->ops->set_bounds (component, &bounds);
+    }
+}
